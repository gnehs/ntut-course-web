{
	"name": "ntut-course-web",
	"main": "./src/worker.ts",
	// Set this to today's date
	"compatibility_date": "2026-06-04",
	"assets": {
		"directory": "./dist/",
		"binding": "ASSETS",
		"run_worker_first": ["/api", "/api/*", "/course/*", "/class/*", "/teacher/*"],
		"not_found_handling": "single-page-application",
	},
}
